Writing Tests

Component Test Example

```jsx
import { render, screen, fireEvent } from '@testing-library/react'
import CodeEditor from '../../src/components/CodeEditor'

describe('CodeEditor', () => {
  test('renders with default code', () => {
    render(<CodeEditor code="console.log('test')" onChange={() => {}} />)
    expect(screen.getByText(/console.log/)).toBeInTheDocument()
  })
})
```

Service Test Example

```js
import { reviewService } from '../../src/services/reviewService'
import apiClient from '../../src/services/apiClient'

jest.mock('../../src/services/apiClient')

describe('reviewService', () => {
  test('submitReview sends correct request', async () => {
    const mockData = { code: 'test', language: 'javascript' }
    apiClient.post.mockResolvedValue({ data: { id: '123' } })
    
    const result = await reviewService.submitReview('test', 'javascript')
    expect(apiClient.post).toHaveBeenCalledWith('/reviews/', mockData)
    expect(result).toEqual({ id: '123' })
  })
})
```

Running Tests in CI

```yaml
# GitHub Actions example- name: Run frontend tests
  run: |
    cd frontend
    npm install
    npm test -- --ci --coverage
```

Common Test Patterns

Testing Authentication

```jsx
import { AuthProvider } from '../../src/context/AuthContext'

const renderWithAuth = (ui) => {
  return render(<AuthProvider>{ui}</AuthProvider>)
}
```

Testing API Calls

```jsx
import { render, waitFor } from '@testing-library/react'
import { reviewService } from '../../src/services/reviewService'

jest.mock('../../src/services/reviewService')

test('loads reviews', async () => {
  reviewService.getHistory.mockResolvedValue([{ id: '1' }])
  render(<ReviewList />)
  await waitFor(() => {
    expect(screen.getByText('Review 1')).toBeInTheDocument()
  })
})
```

